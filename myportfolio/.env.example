# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DJANGO SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE (PostgreSQL) — single connection string, e.g. from Neon
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MEDIA STORAGE (Cloudinary) — for persistent uploaded images
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CONTACT EMAIL — Resend (primary, used in production / on Vercel)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get the key at https://resend.com/api-keys (free). When RESEND_API_KEY is set,
# the contact form sends via Resend's HTTP API instead of SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Until you verify your own domain in Resend, keep the onboarding sender below;
# it can only deliver to the email you signed up to Resend with.
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Where contact submissions are delivered (your inbox).
CONTACT_RECIPIENT_EMAIL=egbemichel39@gmail.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EMAIL (SMTP) — fallback only, used when RESEND_API_KEY is empty
# (works on normal servers; SMTP is unreliable on Vercel serverless)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=egbemichel39@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GITHUB PROJECT SYNC
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Whose public repos to import, and an optional read-only PAT to raise the API
# rate limit (60 -> 5000/hr). Create at https://github.com/settings/tokens
# (fine-grained, "Public repositories: read"). Optional for the admin button;
# the scheduled GitHub Action uses its own auto token.
GITHUB_USERNAME=Egbemichel
GITHUB_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NOTES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. For Gmail: Use App Passwords (https://myaccount.google.com/apppasswords), not your regular password
# 3. Never commit this file - it's for reference only
# 4. Copy as .env in root directory for local development
