.venv/
__pycache__/
*.pyc
*.pyo
.env
db.sqlite3
media/
static/dist/
# …but track the compiled Tailwind CSS so the deploy build stays light
# (no Node stage needed in Docker). Rebuild with `npm run build` after CSS changes.
!static/dist/
static/dist/*
!static/dist/css/
static/dist/css/*
!static/dist/css/main.css
node_modules/
staticfiles/
staticfiles_build/
dist/

# Raw project source files (PDF guidelines, originals). The site uses the
# optimised copies in apps/projects/seed_assets/.
/projects/

# Raw brand source folder (includes photos with other people in them).
# The site uses the curated copies in static/brand/.
/public/
